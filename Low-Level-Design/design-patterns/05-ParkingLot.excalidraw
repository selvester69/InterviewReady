    {
      "id": "Pj7bGo0h4ipWBBVkQukE0",
      "type": "text",
      "x": -656.8981131900123,
      "y": 64.1924878429586,
      "width": 515.1596069335938,
      "height": 275,
      "angle": 0,
      "strokeColor": "#1e1e1e",
      "backgroundColor": "transparent",
      "fillStyle": "solid",
      "strokeWidth": 2,
      "strokeStyle": "solid",
      "roughness": 1,
      "opacity": 100,
      "groupIds": [
        "h7ttYbtjuA1tUwjrV11pq"
      ],
      "frameId": null,
      "index": "a1",
      "roundness": null,
      "seed": 1701700425,
      "version": 533,
      "versionNonce": 521012553,
      "isDeleted": false,
      "boundElements": null,
      "updated": 1768846099792,
      "link": null,
      "locked": false,
      "text": "Functional Req:\n- should have multiple levels\n- each level with multiple parking\n- Diffrerent type of vehicles\n- Assign parking spot upon entry and release on Exit\n- track availability of spot in real time\n- multiple entry and exit points\n- pay ticket and automated\n- pay via UPI/ Card/Cash\n- handle parking lot full \n- handle different kind of parking fee.",
      "fontSize": 20,
      "fontFamily": 5,
      "textAlign": "left",
      "verticalAlign": "top",
      "containerId": null,
      "originalText": "Functional Req:\n- should have multiple levels\n- each level with multiple parking\n- Diffrerent type of vehicles\n- Assign parking spot upon entry and release on Exit\n- track availability of spot in real time\n- multiple entry and exit points\n- pay ticket and automated\n- pay via UPI/ Card/Cash\n- handle parking lot full \n- handle different kind of parking fee.",
      "autoResize": true,
      "lineHeight": 1.25
    },
    {
      "id": "wp0N6XxK_n3KFT3nXs1bd",
      "type": "text",
      "x": -24.507488190012282,
      "y": 62.5047437023336,
      "width": 313.8997497558594,
      "height": 375,
      "angle": 0,
      "strokeColor": "#1e1e1e",
      "backgroundColor": "transparent",
      "fillStyle": "solid",

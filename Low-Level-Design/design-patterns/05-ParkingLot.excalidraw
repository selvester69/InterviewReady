      "isDeleted": false,
      "boundElements": null,
      "updated": 1768846099792,
      "link": null,
      "locked": false,
      "text": "use case \n\nActors: \n    - admin\n    - Customer\n    - Parking Attendant\n    - System\nActions:\n    - CRUD parking floor\n    - CRUD parking spot\n    - Add/remove attendant\n    - take ticket\n    - scan ticket\n    - payment -> card/cash/upi\n    - parking price -> add/modify",
      "fontSize": 20,
      "fontFamily": 5,
      "textAlign": "left",
      "verticalAlign": "top",
      "containerId": null,
      "originalText": "use case \n\nActors: \n    - admin\n    - Customer\n    - Parking Attendant\n    - System\nActions:\n    - CRUD parking floor\n    - CRUD parking spot\n    - Add/remove attendant\n    - take ticket\n    - scan ticket\n    - payment -> card/cash/upi\n    - parking price -> add/modify",
      "autoResize": true,
      "lineHeight": 1.25
    },

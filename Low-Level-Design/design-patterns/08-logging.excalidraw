      "link": null,
      "locked": false,
      "text": "req:\n- support different log level\n- log message with timestamp and content\n- multiple output console, file, database\n- configurable level and output\n- threadsafe and concurrent\n- accomodate new levels",
      "fontSize": 20,
      "fontFamily": 5,
      "textAlign": "left",
      "verticalAlign": "top",
      "containerId": null,
      "originalText": "req:\n- support different log level\n- log message with timestamp and content\n- multiple output console, file, database\n- configurable level and output\n- threadsafe and concurrent\n- accomodate new levels",
      "autoResize": true,
      "lineHeight": 1.25
    },

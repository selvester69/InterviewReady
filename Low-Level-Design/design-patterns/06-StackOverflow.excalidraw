      "updated": 1768846479888,
      "link": null,
      "locked": false,
      "text": "Functional requirement:\n- user can post question, answer,comments\n- users can vote on questions and answers\n- questions shuold have tag\n- user can search questions based on tags\n- assign reputation based on upvote\n- handle concurrent access and data consistency.",
      "fontSize": 20,
      "fontFamily": 5,
      "textAlign": "left",
      "verticalAlign": "top",
      "containerId": null,
      "originalText": "Functional requirement:\n- user can post question, answer,comments\n- users can vote on questions and answers\n- questions shuold have tag\n- user can search questions based on tags\n- assign reputation based on upvote\n- handle concurrent access and data consistency.",
      "autoResize": true,
      "lineHeight": 1.25
    },
